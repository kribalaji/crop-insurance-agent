# gemini (default) | anthropic | ollama
LLM_PROVIDER=gemini
# Optional: override the provider's default model
# LLM_MODEL=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ERA5 NetCDF under $DATA_DIR/era5/, IMD NetCDF under $DATA_DIR/imd/
DATA_DIR=./data
CACHE_DIR=./cache
POLICIES_DIR=./policies
# CHROMA_DIR defaults to $CACHE_DIR/chroma
# CHROMA_DIR=
